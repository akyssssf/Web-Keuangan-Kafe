# Meneruskan semua request ke folder public/ (front controller Laravel).
# Dipakai saat document root hosting tidak bisa diarahkan langsung ke public/,
# seperti pada deployment Git yang menargetkan public_html.

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Jangan proses ulang request yang sudah diarahkan ke public/
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

# Lapis pengaman kalau mod_rewrite mati: tutup akses langsung ke file sensitif.
<FilesMatch "^\.env">
    Require all denied
</FilesMatch>

<FilesMatch "\.(sqlite|sqlite3|db)$">
    Require all denied
</FilesMatch>

Options -Indexes
